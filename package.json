{
  "name": "nim-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:push": "pnpm --filter @nimstudio/db db:push",
    "build:db": "pnpm --filter @nimstudio/db build",
    "build:server": "pnpm --filter @nimstudio/server build",
    "build:web": "next build",
    "build": "pnpm db:push && pnpm build:db && pnpm build:server && pnpm build:web",
    "start:web": "next start",
    "start:server": "pnpm --filter @nimstudio/server start",
    "start": "concurrently \"pnpm start:web\" \"pnpm start:server\"",
    "dev:web": "next dev",
    "dev:server": "pnpm --filter @nimstudio/server dev",
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:server\""
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.10.0",
    "shiki": "^4.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "approvedBuilds": [
      "msw"
    ]
  }
}
